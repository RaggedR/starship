    "demo": "deno run --allow-read --allow-write src/demo.ts",
    "maze": "deno run --allow-read --allow-write --allow-net --allow-env src/maze-demo.ts",
    "fleet": "deno run --allow-read --allow-write --allow-net --allow-env src/fleet-maze-demo.ts",
    "swarm": "deno run --allow-read --allow-write --allow-net --allow-env src/swarm-maze-demo.ts",
